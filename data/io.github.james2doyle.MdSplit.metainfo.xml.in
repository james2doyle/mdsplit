<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.james2doyle.MdSplit</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>MD Split</name>
  <summary>Edit Markdown with a live preview</summary>
  <description>
    <p>
      MD Split is a native GNOME Markdown editor. It shows your document and a
      live preview side by side, with the preview rendered as real GTK widgets
      rather than in a web view.
    </p>
    <p>Features include:</p>
    <ul>
      <li>GitHub-Flavored Markdown tables, task lists, strikethrough, autolinks, alerts and footnotes</li>
      <li>Syntax-highlighted editing with GtkSourceView</li>
      <li>Native headings, lists, block quotes, code blocks, tables and images</li>
      <li>Light and dark Adwaita themes</li>
      <li>Open, edit and save Markdown files</li>
    </ul>
  </description>

  <screenshots>
    <screenshot type="default">
      <image type="source" width="1150" height="770">https://raw.githubusercontent.com/james2doyle/mdsplit/v1.7.0/docs/screenshot.png</image>
      <caption>Markdown source and rendered preview side by side</caption>
    </screenshot>
  </screenshots>

  <developer id="io.github.james2doyle">
    <name>James Doyle</name>
  </developer>

  <url type="homepage">https://github.com/james2doyle/mdsplit</url>
  <url type="bugtracker">https://github.com/james2doyle/mdsplit/issues</url>
  <url type="vcs-browser">https://github.com/james2doyle/mdsplit</url>

  <translation type="gettext">md_split</translation>
  <launchable type="desktop-id">io.github.james2doyle.MdSplit.desktop</launchable>

  <categories>
    <category>Utility</category>
    <category>TextEditor</category>
  </categories>

  <keywords>
    <keyword>markdown</keyword>
    <keyword>editor</keyword>
    <keyword>notes</keyword>
    <keyword>text</keyword>
  </keywords>

  <provides>
    <binary>md_split</binary>
  </provides>

  <requires>
    <control>keyboard</control>
    <control>pointing</control>
    <display_length compare="ge">768</display_length>
  </requires>

  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#3369f4</color>
    <color type="primary" scheme_preference="dark">#0a1f71</color>
  </branding>

  <releases>
    <release version="1.7.0" date="2026-11-27">
      <description translate="no">
        <p>A more capable Markdown authoring release with smarter editing, link and image insertion, and reliability fixes.</p>
        <ul>
          <li>Auto-pair brackets, quotes, and Markdown delimiters with code-aware closing, deletion, and a preference toggle.</li>
          <li>Move or duplicate lines, jump directly to a line, indent nested lists, and toggle task markers with new keyboard shortcuts.</li>
          <li>Insert links with Ctrl+K, open local Markdown links in a new instance, and add images through the picker, drag-and-drop, or the clipboard.</li>
          <li>Keep inserted images portable with relative paths and managed assets, validated by the same size limits as the preview.</li>
          <li>Fix menu actions that could lose editor focus, structured GLib warning filtering, and development launches inside a host AppImage.</li>
        </ul>
      </description>
    </release>
    <release version="1.6.1" date="2026-11-20">
      <description translate="no">
        <p>Flatpak file access and spell-check defaults.</p>
        <ul>
          <li>Spell checking selects the provider's locale default when no language is configured.</li>
          <li>The Flatpak shares the home directory, so command-line paths, recent files, session paths, and user dictionaries under home work directly.</li>
          <li>File-open errors explain when the Flatpak sandbox cannot access a location and how to grant access.</li>
          <li>Document the Flatpak command-line path and filesystem access rules.</li>
        </ul>
      </description>
    </release>
    <release version="1.6.0" date="2026-11-20">
      <description translate="no">
        <p>Flatpak spell checking and source link navigation.</p>
        <ul>
          <li>Flatpak builds bundle libspelling, so spell checking works without host packages.</li>
          <li>Grant Flatpak read-only access to custom hunspell dictionaries with Flatseal or flatpak override.</li>
          <li>Ctrl+click links in the source editor to open inline, autolink, and reference links.</li>
          <li>The pointer becomes a hand over links while Ctrl is held.</li>
          <li>Missing local files and unsupported link schemes show a clear error.</li>
          <li>Refresh the documentation index and installation instructions.</li>
        </ul>
      </description>
    </release>
    <release version="1.5.0" date="2026-11-19">
      <description translate="no">
        <p>Flatpak distribution update.</p>
        <ul>
          <li>Rename the application ID to io.github.james2doyle.MdSplit.</li>
          <li>Update the desktop entry, GSettings schema, D-Bus service, icons and Flatpak manifest to the new ID.</li>
          <li>Publish signed stable Flatpak builds through a project repository.</li>
          <li>Install once and receive later releases with flatpak update.</li>
          <li>The new application ID starts with fresh settings; settings from com.james2doyle.MdSplit are not migrated.</li>
        </ul>
      </description>
    </release>
    <release version="1.4.0" date="2026-11-19">
      <description translate="no">
        <p>Editing, export and multi-instance update.</p>
        <ul>
          <li>Start a separate process with --new-instance while normal launches reuse the running app.</li>
          <li>Copy the active file path from the main menu.</li>
          <li>Control the PDF base font size from Preferences.</li>
          <li>HTML export uses system fonts, a new.css-derived stylesheet, and the viewer's light or dark preference.</li>
          <li>Find Next and Find Previous cycle through matches; PDF export drops HTML comments.</li>
          <li>Task-list checkboxes align with their text.</li>
        </ul>
      </description>
    </release>
    <release version="1.3.0" date="2026-11-18">
      <description translate="no">
        <p>Startup, Vim and packaging update.</p>
        <ul>
          <li>Preview rendering and syntax highlighting wait for the first frame.</li>
          <li>Vim mode no longer shows a block cursor when Vim is inactive.</li>
          <li>Simpler preferences dialog and quieter libenchant log output.</li>
          <li>AppImage ships the pinned official type2 runtime.</li>
        </ul>
      </description>
    </release>
    <release version="1.2.0" date="2026-11-18">
      <description translate="no">
        <p>Navigation and performance update.</p>
        <ul>
          <li>Optional Vim keybindings for the editor and preview.</li>
          <li>Faster startup with deferred imports and shipped bytecode.</li>
          <li>Updated demo document and screenshot.</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-11-17">
      <description translate="no">
        <p>Writing and packaging update.</p>
        <ul>
          <li>Find and replace, selection statistics and reading time.</li>
          <li>Autosave recovery, session restore and external-change prompts.</li>
          <li>Markdown formatting with optional format-on-save.</li>
          <li>Optional spell checking and AppImage builds.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-11-16">
      <description translate="no">
        <p>First stable release.</p>
      </description>
    </release>
  </releases>
</component>
