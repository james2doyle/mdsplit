using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Documents");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "New Document");
      action-name: "app.new";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Open");
      action-name: "app.open";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Save");
      action-name: "app.save";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Save As");
      action-name: "app.save-as";
    }
  }

  Adw.ShortcutsSection {
    title: _("Search");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Find");
      action-name: "app.find";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Find Next");
      action-name: "app.find-next";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Find Previous");
      action-name: "app.find-previous";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Replace");
      action-name: "app.replace";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Go to Line");
      action-name: "app.go-to-line";
    }
  }

  Adw.ShortcutsSection {
    title: _("View");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Cycle View");
      action-name: "app.cycle-view";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }
  }

  Adw.ShortcutsSection {
    title: _("Editing");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Insert Link");
      action-name: "app.insert-link";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Paste Image from Clipboard");
      action-name: "app.paste-image";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Move Lines Up");
      action-name: "app.move-lines-up";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Move Lines Down");
      action-name: "app.move-lines-down";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Duplicate Line or Selection");
      action-name: "app.duplicate-line";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Toggle Task");
      action-name: "app.toggle-task";
    }
  }

  Adw.ShortcutsSection {
    title: _("Formatting");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Bold");
      action-name: "app.format-bold";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Italic");
      action-name: "app.format-italic";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Underline");
      action-name: "app.format-underline";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Block Quote");
      action-name: "app.format-blockquote";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Code");
      action-name: "app.format-code";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Format Document");
      action-name: "app.format-document";
    }
  }

  Adw.ShortcutsSection {
    title: _("Application");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Preferences");
      action-name: "app.preferences";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }
  }
}
