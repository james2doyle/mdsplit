using Gtk 4.0;
using Adw 1;

template $MdSplitPreferencesDialog: Adw.PreferencesDialog {
  title: _("Preferences");

  Adw.PreferencesPage {
    title: _("General");

    Adw.PreferencesGroup {
      title: _("Appearance");
      description: _("Choose how MD Split follows or overrides the system theme.");

      Adw.ComboRow appearance_row {
        title: _("Theme");
        subtitle: _("System, light, or dark");
      }
    }

    Adw.PreferencesGroup {
      title: _("Documents");

      Adw.SwitchRow switch_load_demo {
        title: _("Load demo document on startup");
        subtitle: _("Show the bundled Markdown demo when no file is opened");
      }

      Adw.SwitchRow switch_restore_session {
        title: _("Restore previous session");
        subtitle: _("Reopen file windows from the last session when no file is opened");
      }

      Adw.SwitchRow switch_autosave {
        title: _("Autosave recovery drafts");
        subtitle: _("Write unsaved text to the recovery directory while typing");
      }

      Adw.SpinRow spin_autosave_interval {
        title: _("Autosave interval");
        subtitle: _("Seconds between recovery drafts");
        digits: 0;
      }

      Adw.SwitchRow switch_backups {
        title: _("Keep timestamped backups");
        subtitle: _("Save a copy of the previous text when saving a file");
      }

      Adw.SpinRow spin_backup_retention {
        title: _("Backups to keep");
        subtitle: _("Oldest backups are removed first");
        digits: 0;
      }

      Adw.SwitchRow switch_autocomplete_links {
        title: _("Complete empty links");
        subtitle: _("Turn [] into []() and place the cursor inside the parentheses");
      }

      Adw.SwitchRow switch_format_on_save {
        title: _("Format Markdown on save");
        subtitle: _("Normalize headings, lists, tables, and whitespace before writing");
      }
    }

    Adw.PreferencesGroup {
      title: _("Export");
      description: _("Applies to PDF export.");

      Adw.SpinRow spin_export_font_size {
        title: _("PDF font size");
        subtitle: _("Size in points; headings, code, tables, and captions scale with it");
        digits: 0;
      }
    }

    Adw.PreferencesGroup {
      title: _("Editor");

      Adw.SwitchRow switch_auto_pairing {
        title: _("Auto-pair delimiters");
        subtitle: _("Insert and remove matching brackets, quotes, and Markdown markers while typing");
      }

      Adw.SwitchRow switch_vim_mode {
        title: _("Vim keybindings");
        subtitle: _("Modal editing in the editor and Vim navigation in the preview");
      }
    }

    Adw.PreferencesGroup {
      title: _("Spelling");

      Adw.SwitchRow switch_spell_check {
        title: _("Check spelling while typing");
        subtitle: _("Underline words that are not in the selected dictionary");
      }

      Adw.ComboRow combo_spell_language {
        title: _("Language");
        subtitle: _("Dictionary used for spell checking");
      }
    }

    Adw.PreferencesGroup {
      title: _("Preview");

      Adw.SwitchRow switch_sync_scroll {
        title: _("Sync scrolling");
        subtitle: _("Keep the editor and preview at the same relative position");
      }

      Adw.SwitchRow switch_remote_images {
        title: _("Load remote images");
        subtitle: _("Fetch HTTP and HTTPS images referenced by the document");
      }
    }
  }
}
