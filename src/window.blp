using Gtk 4.0;
using Adw 1;
using GtkSource 5;

template $MdSplitWindow: Adw.ApplicationWindow {
  title: _("MD Split");
  default-width: 1100;
  default-height: 720;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
      [start]
      Button button_open {
        icon-name: "folder-open-symbolic";
        tooltip-text: _("Open…");
        action-name: "app.open";
      }

      [start]
      Button button_save {
        icon-name: "document-save-symbolic";
        tooltip-text: _("Save");
        action-name: "app.save";
      }

      title-widget: Adw.WindowTitle window_title {
        title: _("Untitled.md");
        subtitle: _("Not saved");
      };

      [end]
      MenuButton button_recent {
        icon-name: "document-open-recent-symbolic";
        tooltip-text: _("Recent Files");
      }

      [end]
      MenuButton button_view {
        icon-name: "view-dual-symbolic";
        tooltip-text: _("View Mode");
        menu-model: view_menu;
      }

      [end]
      MenuButton button_menu {
        primary: true;
        icon-name: "open-menu-symbolic";
        menu-model: main_menu;
        tooltip-text: _("Main Menu");
      }
    }

    content: Gtk.Paned paned {
      position: 540;
      resize-start-child: true;
      shrink-start-child: false;
      shrink-end-child: false;

      start-child: Gtk.Overlay editor_pane {
        child: Box editor_box {
          orientation: vertical;

          Gtk.SearchBar search_bar {
            show-close-button: true;

            child: Box search_panel {
              orientation: vertical;
              spacing: 6;
              margin-start: 6;
              margin-end: 6;
              margin-top: 6;
              margin-bottom: 6;

              Box search_find_row {
                orientation: horizontal;
                spacing: 6;

                Gtk.SearchEntry search_entry {
                  hexpand: true;
                  placeholder-text: _("Find");
                }

                ToggleButton search_case_button {
                  label: _("Aa");
                  tooltip-text: _("Match Case");
                }

                ToggleButton search_word_button {
                  label: _("ab");
                  tooltip-text: _("Whole Words");
                }

                ToggleButton search_regex_button {
                  label: _(".*");
                  tooltip-text: _("Regular Expression");
                }

                ToggleButton search_wrap_button {
                  label: _("Wrap");
                  active: true;
                  tooltip-text: _("Wrap Around");
                }

                Label search_status_label {
                  label: _("0 matches");
                  styles [
                    "caption",
                    "dim-label",
                  ]
                }

                Button search_previous_button {
                  icon-name: "go-up-symbolic";
                  tooltip-text: _("Previous Match");
                }

                Button search_next_button {
                  icon-name: "go-down-symbolic";
                  tooltip-text: _("Next Match");
                }
              }

              Box replace_row {
                orientation: horizontal;
                spacing: 6;
                visible: false;

                Entry replace_entry {
                  hexpand: true;
                  placeholder-text: _("Replace");
                }

                Button replace_button {
                  label: _("Replace");
                }

                Button replace_all_button {
                  label: _("Replace All");
                }
              }
            };
          }

          Gtk.ScrolledWindow editor_scroller {
            hscrollbar-policy: never;
            has-frame: false;
            vexpand: true;

            child: GtkSource.View editor_view {
              wrap-mode: word;
              monospace: true;
              show-line-numbers: true;
              highlight-current-line: true;
              auto-indent: true;
              indent-on-tab: true;
              tab-width: 2;
              indent-width: 2;
              left-margin: 18;
              right-margin: 18;
              top-margin: 18;
              bottom-margin: 18;
            };
          }
        };

        [overlay]
        Label placeholder_label {
          label: _("Start writing Markdown…");
          halign: start;
          valign: start;
          margin-start: 76;
          margin-top: 19;
          can-target: false;
          styles [
            "dim-label",
          ]
        }
      };

      end-child: Gtk.Overlay preview_pane {
        child: Adw.Bin preview_container {
          hexpand: true;
        };

        [overlay]
        Revealer preview_prompt_revealer {
          visible: false;
          valign: end;
          transition-type: slide_up;

          child: Box preview_prompt {
            orientation: horizontal;
            spacing: 4;
            margin-start: 6;
            margin-end: 6;
            margin-bottom: 6;
            styles [
              "toolbar",
              "osd",
            ]

            Label preview_prompt_prefix {
              label: C_("vim search prompt", "/");
              styles [
                "monospace",
              ]
            }

            Entry preview_prompt_entry {
              hexpand: true;
              placeholder-text: _("Search preview");
              styles [
                "monospace",
              ]
            }
          };
        }
      };
    };

    [bottom]
    Box status_bar {
      orientation: horizontal;
      spacing: 12;
      margin-start: 12;
      margin-end: 12;
      margin-top: 4;
      margin-bottom: 4;
      styles [
        "toolbar",
      ]

      Label label_cursor {
        label: _("Ln 1, Col 1");
        xalign: 0;
        styles [
          "caption",
          "dim-label",
        ]
      }

      Label label_vim {
        visible: false;
        xalign: 0;
        ellipsize: end;
        styles [
          "caption",
          "dim-label",
          "numeric",
        ]
      }

      Box {
        hexpand: true;
      }

      Label label_stats {
        label: _("0 words · 0 characters");
        halign: end;
        styles [
          "caption",
          "dim-label",
        ]
      }

      Label label_engine {
        label: _("GitHub Markdown");
        halign: end;
        styles [
          "caption",
          "dim-label",
        ]
      }
    }
    };
  };
}

menu main_menu {
  section {
    item {
      label: _("_New");
      action: "app.new";
    }
    item {
      label: _("_Open…");
      action: "app.open";
    }
  }
  section {
    item {
      label: _("_Save");
      action: "app.save";
    }
    item {
      label: _("Save _As…");
      action: "app.save-as";
    }
    item {
      label: _("Copy _Path");
      action: "app.copy-path";
    }
  }
  section {
    item {
      label: _("_Find…");
      action: "app.find";
    }
    item {
      label: _("Find _Next");
      action: "app.find-next";
    }
    item {
      label: _("Find _Previous");
      action: "app.find-previous";
    }
    item {
      label: _("_Replace…");
      action: "app.replace";
    }
    item {
      label: _("Go to _Line…");
      action: "app.go-to-line";
    }
  }
  section {
    item {
      label: _("Insert _Link");
      action: "app.insert-link";
    }
    item {
      label: _("Insert _Image…");
      action: "app.insert-image";
    }
    item {
      label: _("_Paste Image from Clipboard");
      action: "app.paste-image";
    }
    item {
      label: _("Move Lines _Up");
      action: "app.move-lines-up";
    }
    item {
      label: _("Move Lines Dow_n");
      action: "app.move-lines-down";
    }
    item {
      label: _("_Duplicate Line or Selection");
      action: "app.duplicate-line";
    }
    item {
      label: _("_Toggle Task");
      action: "app.toggle-task";
    }
    item {
      label: _("_Format Document");
      action: "app.format-document";
    }
  }
  section {
    item {
      label: _("Export _HTML…");
      action: "app.export-html";
    }
    item {
      label: _("Export _PDF…");
      action: "app.export-pdf";
    }
  }
  section {
    item {
      label: _("Both Panes");
      action: "app.view-mode";
      target: "both";
    }
    item {
      label: _("Source Only");
      action: "app.view-mode";
      target: "source";
    }
    item {
      label: _("Preview Only");
      action: "app.view-mode";
      target: "preview";
    }
    item {
      label: _("Load _Remote Images");
      action: "app.remote-images";
    }
  }
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }
    item {
      label: _("Keyboard _Shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("_About MD Split");
      action: "app.about";
    }
  }
  section {
    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}

menu view_menu {
  section {
    item {
      label: _("Both Panes");
      action: "app.view-mode";
      target: "both";
    }
    item {
      label: _("Source Only");
      action: "app.view-mode";
      target: "source";
    }
    item {
      label: _("Preview Only");
      action: "app.view-mode";
      target: "preview";
    }
  }
}
